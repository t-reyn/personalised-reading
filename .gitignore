# logs & local
*.log
.DS_Store
Thumbs.db

# secrets — never commit a token
.env
.env.*

# local reader profile (derived from private context — never publish to the public repo)
*.local.json

# private reader state — lives in the PRIVATE t-reyn/cortex-state repo since the 2026-07-18 split
# (materialised into data/ at runtime by the workflows; kept out of this public repo's history)
data/reading-state.json
data/knowledge.json
data/corpus.json

# the day's research handoff (pick -> research -> author). Both quote the reader's read history,
# taste votes and failed quizzes, so they are as private as reading-state.json itself. Rebuilt from
# scratch every run, archived to cortex-state/briefs/, and deleted before the Pages upload.
data/digest-today.json
data/brief-today.md

# unpublished drafts
articles/**/_drafts/

# node (there are no deps, but just in case)
node_modules/

# local editor / preview config
.claude/
